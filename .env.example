# ============================================================
# EPADM — Environment Variables (example)
# Copy to .env.local (git-ignored) and fill in real values.
# See docs/DATABASE_ROLES.md for the two-role security model.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# The application connection. MUST use the non-superuser, NOBYPASSRLS
# role (epadm_app) in every environment except throwaway local dev, so
# Row-Level Security is actually enforced. See docker/init/01-roles.sql.
DATABASE_URL="postgres://epadm_app:app_password@localhost:5432/epadm"

# Control-plane / provisioning connection. Uses the BYPASSRLS role
# (epadm_ops) for cross-tenant work: login, registration, tenant
# provisioning, seeding, metering. Falls back to DATABASE_URL if unset.
OPS_DATABASE_URL="postgres://epadm_ops:ops_password@localhost:5432/epadm"

# Optional: connection used by the RLS probe test (tests/rls-isolation.test.ts)
# to enforce cross-tenant isolation at the DB layer. MUST be the non-superuser
# epadm_app role — a superuser/BYPASSRLS role makes the isolation assertion skip.
# Falls back to DATABASE_URL if unset.
APP_TEST_DATABASE_URL="postgres://epadm_app:app_password@localhost:5432/epadm"

# ── Auth / Secrets ───────────────────────────────────────────
# 64-hex-char (256-bit) secret for signing session JWTs.
JWT_SECRET="change-me-to-a-64-char-hex-secret"

# Bootstrap key for platform super-admin operations.
SUPER_ADMIN_KEY="change-me"

# Shared secret for the scheduled invoice-generation cron
# (api/admin/cron/invoices). The scheduler sends it as
# `Authorization: Bearer <CRON_SECRET>` and names the tenant via the
# request body `{ "tenantId": "<uuid>" }`. Leave unset to disable the
# machine path (interactive callers with fees.write still work).
CRON_SECRET="change-me-to-a-long-random-string"

# ── Redis (sessions, tenant cache, metering queue) ───────────
REDIS_URL=redis://localhost:6379

# ── Ops / Tenant routing ─────────────────────────────────────
OPS_HOST=ops.localhost
TENANT_DOMAIN_SUFFIX=schoolapp.com

# ── Platform operator seed ───────────────────────────────────
SEED_PLATFORM_EMAIL=admin
SEED_PLATFORM_PASSWORD=change-me
SEED_PLATFORM_MFA=true

# ── Site (public) ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_LOGIN_URL=/app/login
NEXT_PUBLIC_CMS_URL=/admin
NEXT_PUBLIC_APP_FORGOT_URL=/app/forgot-password
NEXT_PUBLIC_CONTACT_EMAIL=hello@epadm.io

# ── E2E (optional) ───────────────────────────────────────────
# Point Playwright at an already-running server instead of booting one.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
